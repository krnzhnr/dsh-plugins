{
  "name": "@local/dsh-mambo-pet",
  "version": "1.2.0",
  "private": true,
  "description": "Mambo pet for DeepSeek Harness: frames2d companion (8 tracks, 421 frames, stock 0.4.16 compatible)",
  "dependencies": {
    "@linxin666/dsh-pet": "0.4.16"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "pets/**/*",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
